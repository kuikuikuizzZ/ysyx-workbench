# Chisel 生成 verilog 配置
CHISEL_VERILOG_SOC_CONFIG=ICACHE_SIZE_BITS=2
CHISEL_VERILOG_SOC_CONFIG+=ICACHE_BLOCK_BITS=1
CHISEL_VERILOG_SOC_CONFIG+=ICACHE_ENABLE_BURST=true

verilog_soc: 
	@echo CHISEL_VERILOG_SOC_CONFIG $(CHISEL_VERILOG_SOC_CONFIG)
	$(MAKE) -C $(NPC_CHISEL_HOME) $(CHISEL_VERILOG_SOC_CONFIG) verilog
